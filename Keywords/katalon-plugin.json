{
   "name": "Katalon Sauce Labs Integration",
   "listeners": ["SauceLabsTestListener"],
   "configuration": {
      "settingId": "com.kms.katalon.keyword.Saucelabs-keywords",
      "settingPage": {
         "name": "Sauce Labs Integration",
         "components": [
            {
               "key": "",
               "type": "label",
               "label": "Job's information"
            },
            {
               "key": "accessKey",
               "type": "secret",
               "label": "API Key",
               "defaultValue": ""
            },
            {
               "key": "username",
               "type": "text",
               "label": "Username",
               "defaultValue": ""
            },
            {
               "key": "browserName",
               "type": "text",
               "label": "Browser's name",
               "defaultValue": "Chrome"
            },
            {
               "key": "platform",
               "type": "text",
               "label": "Platform",
               "defaultValue": "Windows 11"
            },
            {
               "key": "version",
               "type": "text",
               "label": "Version",
               "defaultValue": "latest"
            },
            {
               "key": "name",
               "type": "text",
               "label": "Job's name",
               "defaultValue": "Default Job"
            },
            {
               "key": "",
               "type": "label",
               "label": "Global configuration"
            },
            {
					"key": "dataCenter",
					"type": "text",
					"label": "Data Center (e.g. us-west-1, us-east-1, eu-central-1)",
					"defaultValue": "us-west-1"
				},
            {
               "key": "Sauce Labs Desired Capabilities Generator",
               "type": "button",
               "label": "Generate Sauce Labs Custom Profile",
	            "implementationClassPath": "com.kms.katalon.keyword.saucelabs.SauceLabsButtonSelectionEventHandler",
               "defaultValue": ""
            }
         ]
      }
   }
}
